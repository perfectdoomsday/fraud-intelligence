{
  "uid": "fraud-overview",
  "title": "Fraud Intelligence — API Observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {"id":1,"type":"timeseries","title":"HTTP requests per second","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(fraud_http_requests_total[5m])) by (route)","legendFormat":"{{route}}"}]},
    {"id":2,"type":"timeseries","title":"Request latency p95","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(fraud_http_request_duration_seconds_bucket[5m])) by (le, route))","legendFormat":"{{route}}"}]},
    {"id":3,"type":"stat","title":"Transactions processed","gridPos":{"x":0,"y":8,"w":8,"h":5},"targets":[{"expr":"sum(fraud_transactions_processed_total)"}]},
    {"id":4,"type":"stat","title":"Alerts created","gridPos":{"x":8,"y":8,"w":8,"h":5},"targets":[{"expr":"sum(fraud_alerts_created_total)"}]},
    {"id":5,"type":"stat","title":"Processing failures","gridPos":{"x":16,"y":8,"w":8,"h":5},"targets":[{"expr":"sum(fraud_transactions_failed_total)"}]}
  ],
  "time": {"from":"now-1h","to":"now"},
  "timezone":"browser"
}

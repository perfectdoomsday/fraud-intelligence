# Copy to .env. Values below are for local development only.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fraud_app:local-postgres-only-change-me@localhost:5432/fraud_intelligence
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
MODEL_ARTIFACT_PATH=artifacts/demo_fraud_model.joblib
POSTGRES_PASSWORD=local-postgres-only-change-me
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-use
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=replace-this-local-demo-password
MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=replace-this-minio-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-this-grafana-password
